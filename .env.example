# Build-time client config for `npm run build` / `npm run dev`.
# Copy to `.env` locally; in production set these as build environment
# variables in the Cloudflare Pages project settings.
#
# These are NOT secrets. Anything prefixed VITE_ is inlined into the public
# JS bundle — that is fine for pixel IDs, which are public on every site that
# uses them. Never put the Meta CAPI token here; it belongs in .dev.vars /
# Cloudflare secrets (see .dev.vars.example).
#
# Leave any of these blank and that tag simply never loads.

# Google Analytics 4 measurement id
VITE_GA4_ID=G-XXXXXXXXXX

# Meta (Facebook) pixel id — the same numeric id as META_PIXEL_ID
VITE_META_PIXEL_ID=1234567890123456

# TikTok pixel id from TikTok Events Manager
VITE_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXX

# ── Consent ───────────────────────────────────────────────────────────────
# All three tags are additionally gated at runtime by the visitor's privacy
# choice (src/consent.js). Setting an ID here makes a tag *available*; it does
# not make it load. Nothing loads before the visitor decides, GA4 needs the
# "analytics" category, and Meta/TikTok need "advertising" — which Global
# Privacy Control switches off automatically.
